# Script Orchestrator Configuration
# Use local scripts directory for demo
USE_LOCAL_SCRIPTS=true
SCRIPTS_DIR=example_scripts

# Orchestrator Configuration
AIRFLOW_ENABLED=true
AIRFLOW_VERSION=3.1
AIRFLOW_AUTO_INSTALL=true

PREFECT_ENABLED=true
# PREFECT_VERSION=3.0
# PREFECT_AUTO_INSTALL=true

# For GitHub mode (alternative to local mode):
# USE_LOCAL_SCRIPTS=false
# SCRIPTS_REPO_URL=https://github.com/your-org/your-scripts-repo
# SCRIPTS_REPO_BRANCH=main
# SCRIPTS_DIR=scripts
# GITHUB_TOKEN=your_github_token_here
